# ─────────────────────────────────────────────────────────────
#  FINPRO — variables de entorno
#  Copia este archivo a ".env" y ajusta los valores:  cp .env.example .env
#  NUNCA subas el archivo .env real a Git.
# ─────────────────────────────────────────────────────────────

# Entorno: development | production | test
NODE_ENV=development

# Puerto donde corre el servidor (API + frontend)
PORT=3000

# URL pública de la aplicación (se usa para armar el enlace del correo de recuperación)
APP_URL=http://localhost:3000

# Ruta del archivo SQLite (se crea automáticamente)
DATABASE_PATH=./data/finpro.db

# Duración de la sesión en días (se renueva mientras el usuario usa la app)
SESSION_TTL_DAYS=7

# Costo de bcrypt (10-14). Más alto = más seguro pero más lento.
BCRYPT_ROUNDS=12

# Permitir que cualquier persona cree una cuenta desde /register.html (true | false)
ALLOW_REGISTRATION=true

# En producción detrás de HTTPS la cookie de sesión debe ser "secure"
# (por defecto es true cuando NODE_ENV=production). Ponlo en false solo si pruebas
# producción por HTTP local.
# COOKIE_SECURE=true

# Si usas un proxy inverso (Nginx, Render, Railway, etc.) pon el número de proxies de confianza
# TRUST_PROXY=1

# ── Correo (recuperación de contraseña) ──────────────────────
# Sin SMTP configurado, el enlace de recuperación se imprime en la consola del servidor
# (útil para desarrollo). Para producción configura un servicio SMTP real
# (Gmail con "contraseña de aplicación", Brevo, Mailgun, Resend SMTP, etc.).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_usuario_smtp
# SMTP_PASS=tu_contraseña_smtp
# MAIL_FROM="FINPRO <no-reply@tu-dominio.com>"
